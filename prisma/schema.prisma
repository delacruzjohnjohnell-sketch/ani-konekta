// ANI-KONEKTA — Prisma schema
// Postgres is required (scalar list fields like String[] are Postgres-only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  BUYER
  HAULER
  ADMIN
  COOPERATIVE_ADMIN
}

enum QualityTag {
  GRADE_A
  ORGANIC
  GAP_CERTIFIED
  STANDARD
}

enum ListingStatus {
  ACTIVE
  MATCHED
  CLOSED
  // Soft-delete only — the row is never hard-deleted so that any Order that
  // already references this listing (Order.listingId is a required FK)
  // keeps working and keeps showing full transaction history, exactly as
  // before, even after the seller "deletes" the listing. See deleteListing
  // in src/app/actions.ts.
  DELETED
}

// Explicit order-status pipeline per spec:
// LISTED -> MATCHED -> ORDERED_ESCROWED -> POOLED -> IN_TRANSIT -> DELIVERED -> SETTLED
enum OrderStatus {
  LISTED
  MATCHED
  ORDERED_ESCROWED
  POOLED
  IN_TRANSIT
  DELIVERED
  SETTLED
  DISPUTED
  // Set once the origin Gate Pass inspection is complete and signed off by
  // the seller/cooperative — locks the origin weight/quality baseline.
  INSPECTED_PICKUP
}

enum EscrowStatus {
  HELD
  // Dockside partial acceptance: the undisputed fraction has been released,
  // only the disputed fraction is still held.
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
}

enum RouteStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

enum ReputationEventType {
  ON_TIME
  LATE
  DISPUTE
  RESOLVED
}

// --- Additive features: ID verification, KYC, chat, SMS, ANI-Wallet ---
enum IdVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum KycStatus {
  NOT_VERIFIED
  VISIT_SCHEDULED
  UNDER_REVIEW
  KYC_VERIFIED
  REJECTED
}

enum SmsDirection {
  IN
  OUT
}

enum WalletTransactionType {
  TOP_UP
  WITHDRAWAL
  HOLD
  RELEASE
  REFUND
}

// --- Escrow release lockdown ---------------------------------------------
enum EscrowTriggerType {
  BUYER_CONFIRM
  AUTO_TIMEOUT
  ADMIN_DUAL_APPROVAL
  BUYER_PARTIAL_RECEIPT
  ADMIN_MEDIATION
}

// --- Dual-track supply model, commodity freight, dispatch, QA ------------
enum OwnerType {
  INDIVIDUAL_SELLER
  COOPERATIVE
}

enum CropCategory {
  GRAIN
  VEGETABLE
  FRUIT
}

enum GrainGrade {
  GRADE_1
  GRADE_2
  GRADE_3
  WET_UNCLASSIFIED
}

enum ProduceClass {
  CLASS_EXTRA
  CLASS_I
  CLASS_II
  SUBSTANDARD
}

enum PackagingType {
  CRATE
  SACK
  BOX
  BUNDLE
}

enum BuyerType {
  RETAIL_SPOT
  INSTITUTIONAL_ENTERPRISE
}

enum RouteZone {
  REGIONAL_MANILA
  LOCAL_PROVINCIAL
}

enum VehicleType {
  TEN_WHEELER
  FORWARD_6W
  CANTER_4W
  VAN_L300
}

enum PaymentTerms {
  PREPAID
  NET_30
}

enum SettlementDisputeStatus {
  OPEN
  RESOLUTION_PROPOSED
  RESOLVED
}

enum SettlementResolutionType {
  SELLER_RELEASE
  BUYER_REFUND
  SPLIT
}

enum LoanEntryType {
  LOAN_ISSUED
  REPAYMENT_DEDUCTION
  ADJUSTMENT
}

enum StagingTicketKind {
  DROP_OFF
  DISPATCH
}

enum DisputeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String   @id @default(cuid())
  name            String
  role            Role
  phone           String   @unique
  email           String?  @unique
  passwordHash    String
  // DEPRECATED — replaced by the 5-star rating system below (ratingSum /
  // ratingCount + the Rating model). Column kept (not dropped) so no data
  // migration is required; nothing in the UI reads or writes it anymore.
  reputationScore Int      @default(100)
  // Denormalized rating counters, updated transactionally in
  // src/app/actions.ts#submitRating whenever a new Rating row is created
  // for this user (as the ratee). Average = ratingSum / ratingCount.
  // Kept denormalized (rather than aggregating Rating rows on every
  // dashboard render) the same way reputationScore was.
  ratingSum       Int      @default(0)
  ratingCount     Int      @default(0)
  municipality    String?
  createdAt       DateTime @default(now())

  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])

  // FEATURE 2 — Cold-Chain Classification. Per-hauler (not per-vehicle) —
  // this app models a hauler as a single-vehicle operator everywhere else
  // (routing, payouts, dashboard), so a fleet/vehicle sub-model would be new
  // complexity nothing else here needs yet. Self-declared by the hauler on
  // their own dashboard; a real onboarding/verification step for this claim
  // is future work (flagged, not built — matches how ID/KYC verification
  // exists but this doesn't reuse it).
  hasRefrigeratedVehicle Boolean @default(false)
  // Declared vehicle class (dispatch engine capacity source); null = unknown.
  vehicleType            VehicleType?

  // Buyer profile (RETAIL_SPOT vs INSTITUTIONAL_ENTERPRISE). INSTITUTIONAL
  // requires registeredBusinessName + tin (enforced server-side at
  // registration). tin is sensitive — never returned by any listing/public
  // query; only the owner and ADMIN read it. invoiceFinancingEligible and
  // creditLimit are set ONLY by an admin — never granted automatically.
  buyerType               BuyerType?
  registeredBusinessName  String?
  tin                     String?
  requiresBir2307         Boolean    @default(false)
  invoiceFinancingEligible Boolean   @default(false)
  creditLimit             Decimal?   @db.Decimal(14, 2)

  listings         Listing[]         @relation("SellerListings")
  buyerOrders      Order[]           @relation("BuyerOrders")
  sellerOrders     Order[]           @relation("SellerOrders")
  haulerRoutes     PooledRoute[]     @relation("HaulerRoutes")
  reputationEvents ReputationEvent[]
  ratingsGiven     Rating[]          @relation("RatingsGiven")
  ratingsReceived  Rating[]          @relation("RatingsReceived")

  // Denormalized current-status fields (same pattern as ratingSum/ratingCount
  // above) — fast to read on every marketplace card with zero extra joins.
  // Detail history lives in IdVerificationSubmission / KycVisit below.
  idVerificationStatus      IdVerificationStatus       @default(NOT_VERIFIED)
  kycStatus                 KycStatus                  @default(NOT_VERIFIED)
  idVerificationSubmissions IdVerificationSubmission[]
  kycVisits                 KycVisit[]
  wallet                    Wallet?
  conversationsAsBuyer      Conversation[]             @relation("ConversationBuyer")
  conversationsAsSeller     Conversation[]             @relation("ConversationSeller")
  messagesSent              Message[]
  haulerMessagesSent        HaulerMessage[]            @relation("HaulerMessageSender")
  haulerMessagesReceived    HaulerMessage[]            @relation("HaulerMessageRecipient")
  smsMessages               SmsMessage[]
  postedListings            Listing[]                  @relation("ListingPostedBy")
  auditLogs                 AuditLog[]
}

model Cooperative {
  id           String   @id @default(cuid())
  name         String
  municipality String
  members      User[]
  createdAt    DateTime @default(now())

  // Sensitive: settlement bank/e-wallet details. Only the cooperative's own
  // admin and ADMIN may read this — never selected by marketplace queries.
  bankInfo     String?

  listings     Listing[]
  orders       Order[]
  farmerMembers CooperativeMember[]
  lots         ConsolidatedLot[]
  stagingTickets StagingHubTicket[]
}

model Listing {
  id                    String        @id @default(cuid())
  // DUAL-TRACK: INDIVIDUAL_SELLER listings have sellerId set and
  // cooperativeId null; COOPERATIVE listings have cooperativeId set and
  // sellerId null (enforced by src/lib/listing-service.ts and a DB CHECK
  // constraint — see prisma/apply-revision-constraints.ts).
  sellerId              String?
  seller                User?         @relation("SellerListings", fields: [sellerId], references: [id])
  ownerType             OwnerType     @default(INDIVIDUAL_SELLER)
  cooperativeId         String?
  cooperative           Cooperative?  @relation(fields: [cooperativeId], references: [id])
  // The user who actually created the listing (the farmer, the cooperative
  // admin, or — for assisted/offline entry — the farmer stays the owner and
  // the coordinator is recorded in assistedByUserId).
  postedByUserId        String?
  postedBy              User?         @relation("ListingPostedBy", fields: [postedByUserId], references: [id])
  assistedEntrySource   String?
  assistedByUserId      String?
  cropCategory          CropCategory  @default(GRAIN)
  // Commodity-adaptive quality data (do not force one standard on all crops)
  isGrainWet            Boolean?
  moistureContentPercent Float?
  grainGrade            GrainGrade?
  produceClass          ProduceClass?
  packagingType         PackagingType?
  harvestTimestamp      DateTime?
  cropType              String
  variety               String?
  volumeKg              Float
  harvestDate           DateTime
  askingPricePerKg      Float
  aiSuggestedPricePerKg Float
  qualityTag            QualityTag    @default(STANDARD)
  municipality          String
  status                ListingStatus @default(ACTIVE)
  // Renamed from `photoUrl` (Feature: direct file attachment, never a pasted
  // URL). Column name kept via @map so existing data isn't moved — this
  // stores the Vercel Blob storage identifier returned by our own upload
  // endpoint, never user-typed text. See src/lib/blob-storage.ts.
  // Any pre-migration row that still holds a raw http(s) URL here was
  // entered before this feature existed — see
  // prisma/report-legacy-photo-urls.ts to find and re-upload those.
  photoBlobKey          String?       @map("photoUrl")
  createdAt             DateTime      @default(now())

  // Optional seller-set floor on how small a single order/cart line can be
  // against this listing. Null = no minimum (buyers may order any amount up
  // to available volumeKg). See src/lib/listing-stock.ts.
  minOrderQtyKg Float?
  // Optional free-text seller description shown on the buyer marketplace card.
  description   String?

  // FEATURE 2 — Cold-Chain Classification. Defaulted per cropType via a
  // regex heuristic (src/lib/cold-chain.ts — same style as the buyer
  // dashboard's existing CATEGORIES matcher), seller-overridable at listing
  // time. coldChainNeedsReview is set by the one-time backfill script
  // (prisma/backfill-cold-chain-classification.ts) for pre-existing crop
  // types the heuristic couldn't confidently classify — never guessed
  // silently, flagged for a human to confirm/correct instead.
  requiresColdChain    Boolean @default(false)
  coldChainNeedsReview Boolean @default(false)

  orders Order[]
  lots   ConsolidatedLot[]
}

model Order {
  id               String       @id @default(cuid())
  listingId        String
  listing          Listing      @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId         String
  seller           User         @relation("SellerOrders", fields: [sellerId], references: [id])
  volumeKg         Float
  agreedPricePerKg Float
  // Produce price only (volumeKg * agreedPricePerKg). The buyer's actual
  // escrowed total also includes logisticsFeeAmountPHP — see below.
  totalAmount      Float
  status           OrderStatus  @default(LISTED)
  escrowStatus     EscrowStatus @default(HELD)
  isBulkMatch      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Set the moment an order (re-)enters DELIVERED (by advanceRouteStatus, or
  // by an admin restoring a resolved dispute back to DELIVERED) — the clock
  // the auto-release cron job (src/app/api/cron/auto-release-escrow) reads
  // against. Resetting it on dispute-resolution gives the buyer a fresh
  // window rather than an instant auto-release right after resolution.
  escrowEligibleAt DateTime?

  // DUAL-TRACK ownership snapshot + commodity freight (tariff snapshot).
  // For cooperative-owned orders sellerId is the cooperative's acting admin
  // user; payouts are routed by ownerType/cooperativeId, never by sellerId.
  ownerType        OwnerType    @default(INDIVIDUAL_SELLER)
  cooperativeId    String?
  cooperative      Cooperative? @relation(fields: [cooperativeId], references: [id])
  cropCategory     CropCategory?
  routeZone        RouteZone?
  freightFloorApplied Boolean?
  // Full tariff row used + every computed component, frozen at order
  // creation so later Admin tariff edits never change historical orders.
  freightSnapshot  Json?
  paymentTerms     PaymentTerms @default(PREPAID)

  // Dockside receiving. dockArrivalAt is SERVER-recorded (never the buyer's
  // device clock); receivingWindowEndsAt = dockArrivalAt + 2h.
  dockArrivalAt         DateTime?
  receivingWindowEndsAt DateTime?
  acceptedWeightKg      Float?
  disputedWeightKg      Float?
  // Merchandise money still held pending dispute mediation (0 otherwise).
  heldSellerNetPHP      Float @default(0)
  heldCommissionPHP     Float @default(0)

  inspection        PreDispatchInspection?
  receipt           OrderReceipt?
  settlementDispute OrderSettlementDispute?
  memberSettlements MemberSettlement[]
  invoices          InvoiceDocument[]

  routeId String?
  route   PooledRoute? @relation(fields: [routeId], references: [id])

  proofOfDelivery        ProofOfDelivery?
  reputationEvents       ReputationEvent[]
  ratings                Rating[]
  conversations          Conversation[]
  walletTransactions     WalletTransaction[]
  escrowEvents           EscrowEvent[]
  disputeReleaseRequests DisputeReleaseRequest[]
  haulerMessages         HaulerMessage[]

  // --- Commission & fee engine snapshot (Feature: Configurable Commission
  // & Fee Engine). Computed once at order-creation time from whichever
  // CommissionConfig rule applied at that moment (see
  // src/lib/commission.ts) and NEVER recomputed afterward — changing
  // CommissionConfig rates later must not alter orders already placed.
  // All fields are nullable because orders created before this feature
  // shipped won't have them until prisma/backfill-commission-snapshots.ts
  // is run against them.
  commissionConfigId                 String?
  commissionConfig                   CommissionConfig? @relation(fields: [commissionConfigId], references: [id])
  appliedSellerCommissionRatePercent Float?
  appliedBuyerLogisticsFeePercent    Float?
  appliedHaulerPayoutPercent         Float?
  sellerCommissionAmountPHP          Float?
  logisticsFeeAmountPHP              Float?
  haulerPayoutAmountPHP              Float?
  platformNetRevenueAmountPHP        Float?
  netPayoutToSellerPHP               Float?
}

// Configurable commission / logistics-fee rules. Rows are never deleted or
// mutated in place once an order has snapshotted them — to change a rate,
// end-date the current row (`effectiveTo`) and insert a new one. Rule
// selection (most-specific-wins) lives in src/lib/commission.ts.
model CommissionConfig {
  id                                String    @id @default(cuid())
  // null = applies to every crop unless a crop-specific rule also matches
  cropType                          String?
  // null = applies at any volume; otherwise a "at least this many kg" tier
  minOrderVolumeKg                  Float?
  sellerCommissionRatePercent       Float     @default(6.00)
  buyerLogisticsFeePercent          Float     @default(2.00)
  // Share of the collected logistics fee paid out to the hauler; the
  // remainder is the platform's logistics margin.
  haulerPayoutPercentOfLogisticsFee Float     @default(75.00)
  // Floor on the platform's total net revenue recognized per order
  // (seller commission + logistics margin), so tiny orders still cover
  // payment-processing overhead.
  minFeeFloorPHP                    Float     @default(20.00)
  effectiveFrom                     DateTime  @default(now())
  effectiveTo                       DateTime?
  createdBy                         String?
  createdAt                         DateTime  @default(now())

  orders Order[]
}

model PooledRoute {
  id           String      @id @default(cuid())
  haulerId     String
  hauler       User        @relation("HaulerRoutes", fields: [haulerId], references: [id])
  orders       Order[]
  pickupPoints String[]
  dropoffPoint String
  status       RouteStatus @default(ASSIGNED)
  etaMinutes   Int?
  distanceKm   Float?
  createdAt    DateTime    @default(now())

  // FEATURE 3 — Live Hauler Location Tracking. A single "current position"
  // field, not a ping-history table (explicitly a "nice-to-have" in the
  // spec, trimmed for MVP scope — flagged, not silently dropped). Written
  // by POST /api/routes/[id]/location (the assigned hauler only, while
  // status is PICKED_UP/IN_TRANSIT); read by the buyer/seller/admin order
  // page via GET on the same route. lastPingAt drives the "stale location"
  // (10-min threshold, per confirmed default) and "Last updated Xs/min ago"
  // display.
  currentLat Float?
  currentLng Float?
  lastPingAt DateTime?

  // Load-deficit dispatch engine (src/lib/dispatch-engine.ts).
  vehicleType          VehicleType?
  capacityKg           Float?
  cutoffAt             DateTime?
  utilizationPct       Float?
  // QUEUED | UNRESOLVED_LOW_UTILIZATION (null until evaluated)
  dispatchDecision     String?
  // 0 = met 60% outright; 1-4 = contingency level that resolved the deficit
  deficitResolvedLevel Int?
  dispatchLog          Json?
  crossDockCooperativeId String?
}

model ProofOfDelivery {
  id               String   @id @default(cuid())
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id])
  deliveredAt      DateTime @default(now())
  confirmedByBuyer Boolean  @default(false)
  qrTraceCode      String   @unique @default(cuid())
  // Renamed from `photoUrl` — see the matching note on Listing.photoBlobKey.
  photoBlobKey     String?  @map("photoUrl")
  notes            String?
}

model ReputationEvent {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])
  type      ReputationEventType
  delta     Int
  note      String?
  createdAt DateTime            @default(now())
}

// Feature: 5-star rating system, replacing the old points-based
// reputationScore. Ratings are only ever created for a SETTLED order (see
// submitRating in src/app/actions.ts, which enforces this and that both
// rater and ratee were actual participants on that order — buyer, seller,
// or the assigned hauler) so ratings can't be faked. The @@unique
// constraint stops one person rating the same counterparty on the same
// order more than once, from either the client or a retried request.
model Rating {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([orderId, raterId, rateeId])
}

// Seeded with mock historical data; powers the moving-average pricing heuristic
// in src/lib/pricing.ts. Clearly a placeholder for a future ML model.
model PriceTrend {
  id            String   @id @default(cuid())
  cropType      String
  municipality  String
  avgPricePerKg Float
  recordedAt    DateTime
}

// --- ID Verification --------------------------------------------------
// One row per submission attempt (a user may be REJECTED and resubmit).
// User.idVerificationStatus is the fast denormalized "current" read;
// this table is the detail/audit log — same shape as Rating vs.
// User.ratingSum/ratingCount above.
model IdVerificationSubmission {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id])
  status           IdVerificationStatus @default(PENDING)
  // Vercel Blob keys (see src/lib/blob-storage.ts) — never rendered as a
  // raw URL to anyone but the owner/ADMIN; always served through
  // src/app/api/secure-doc/[docType]/[docId]/route.ts.
  documentBlobKeys String[]
  note             String?
  reviewedBy       String?
  reviewNote       String?
  createdAt        DateTime             @default(now())
  reviewedAt       DateTime?
}

// --- KYC / physical verification ---------------------------------------
// One row per field-visit attempt. User.kycStatus is the fast denormalized
// "current" read, updated alongside each visit's status transition.
model KycVisit {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  status           KycStatus @default(VISIT_SCHEDULED)
  visitDate        DateTime?
  verifierName     String?
  verifierUserId   String?
  notes            String?
  evidenceBlobKeys String[]
  scheduledBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// --- Buyer <-> Seller chat -----------------------------------------------
// Keyed by (buyerId, sellerId, orderId) — orderId is null for the general
// pre-order/listing-inquiry thread, and set for an order-scoped thread
// created lazily on first order-context message. Postgres treats multiple
// NULLs in a unique index as distinct, so "one general thread per pair" is
// enforced in application code (getOrCreateConversation), not by the DB.
model Conversation {
  id               String    @id @default(cuid())
  buyerId          String
  buyer            User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  orderId          String?
  order            Order?    @relation(fields: [orderId], references: [id])
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime  @default(now())
  messages         Message[]

  @@unique([buyerId, sellerId, orderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

// --- SMS scaffold ---------------------------------------------------------
// Outbound sending already exists (src/lib/notifications.ts#sendSms); this
// is the log of every inbound/outbound SMS-equivalent message, real or
// simulated (see src/app/sms — no telco gateway is connected yet).
model SmsMessage {
  id            String       @id @default(cuid())
  direction     SmsDirection
  phone         String
  body          String
  parsedCommand String?
  parsedResult  String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
}

// --- ANI-Wallet (buyer-only prototype) -----------------------------------
// A real-feeling buyer-side balance ledger sitting in front of the
// already-mocked src/lib/payments.ts — no real money moves either way.
// "Protected" = held against an in-flight order (mirrors Order.escrowStatus
// HELD); "Pending" is reserved for a future async top-up/withdrawal flow.
model Wallet {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id])
  availableBalancePHP Float               @default(0)
  protectedBalancePHP Float               @default(0)
  pendingBalancePHP   Float               @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  transactions        WalletTransaction[]
}

model WalletTransaction {
  id        String                @id @default(cuid())
  walletId  String
  wallet    Wallet                @relation(fields: [walletId], references: [id])
  type      WalletTransactionType
  amountPHP Float
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  note      String?
  createdAt DateTime              @default(now())
}

// --- Escrow release lockdown ---------------------------------------------
// Append-only: every legitimate transition into SETTLED/RELEASED writes
// exactly one row here (BUYER_CONFIRM / AUTO_TIMEOUT / ADMIN_DUAL_APPROVAL —
// the only three code paths allowed to do so, see src/app/actions.ts and
// src/app/api/cron/auto-release-escrow). Application code must never
// update() or delete() a row in this table.
model EscrowEvent {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id])
  fromStatus  String
  toStatus    String
  // userId of who triggered it, or the literal string "SYSTEM" for the
  // auto-release cron job.
  triggeredBy String
  triggerType EscrowTriggerType
  // e.g. { proofOfDeliveryId } for BUYER_CONFIRM, { windowMs } for
  // AUTO_TIMEOUT, { openedBy, approvedBy, requestId } for ADMIN_DUAL_APPROVAL.
  metadata    Json?
  createdAt   DateTime          @default(now())
}

// One row per admin-initiated request to release a DISPUTED order's escrow
// to the seller. `openedBy` is the admin who decides the dispute should
// resolve in the seller's favor; a *different* admin must then approve
// (approveDisputeRelease enforces openedBy != approvedBy) before any money
// moves — see FEATURE 1 spec, "dual control".
model DisputeReleaseRequest {
  id         String                 @id @default(cuid())
  orderId    String
  order      Order                  @relation(fields: [orderId], references: [id])
  openedBy   String
  approvedBy String?
  status     DisputeApprovalStatus  @default(PENDING)
  createdAt  DateTime               @default(now())
  decidedAt  DateTime?
}

// --- FEATURE 4 — In-App Chat (Hauler <-> Seller, Hauler <-> Buyer) --------
// Deliberately separate from the existing Buyer<->Seller Conversation/
// Message models above (Phase 8 chat) rather than repurposing them — those
// are hard-keyed to exactly (buyerId, sellerId), which can't represent a
// hauler-in-the-middle thread without risking that already-shipped feature.
// Scoped per-order (not per-route): a route can carry multiple sellers, so
// per-order keeps each thread unambiguous. Two threads exist per order once
// pooled — Hauler<->Buyer and Hauler<->Seller — distinguished by which two
// users a message is between (sender/recipient), not by a separate
// "thread id": src/lib/hauler-messaging.ts queries by
// (orderId, {senderId, recipientId} pair).
model HaulerMessage {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  senderId    String
  sender      User      @relation("HaulerMessageSender", fields: [senderId], references: [id])
  senderRole  Role
  recipientId String
  recipient   User      @relation("HaulerMessageRecipient", fields: [recipientId], references: [id])
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
}


// ============================================================================
// REVISION: dual-track supply, commodity freight, QA gate passes, dockside
// partial acceptance, cooperative tools, audit, invoicing abstraction.
// ============================================================================

// Live, database-driven freight tariff, unique per (routeZone, cropCategory).
// Checkout ALWAYS reads the current row (src/lib/freight.ts) — the seeded
// values are defaults only, never hard-coded constants.
model CommodityFreightTariff {
  id               String       @id @default(cuid())
  routeZone        RouteZone
  cropCategory     CropCategory
  ratePerKg        Decimal      @db.Decimal(12, 4)
  baseFloorFee     Decimal      @db.Decimal(12, 2)
  tollPassThrough  Decimal      @default(0) @db.Decimal(12, 2)
  haulerSharePct   Decimal      @db.Decimal(5, 4)
  platformSharePct Decimal      @db.Decimal(5, 4)
  updatedByAdminId String?
  updatedAt        DateTime     @updatedAt

  @@unique([routeZone, cropCategory])
}

// Pre-dispatch digital Gate Pass. Once locked (after every required
// sign-off) it is immutable except via an audited Admin correction.
model PreDispatchInspection {
  id                    String    @id @default(cuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id])
  haulerId              String
  actualPickupWeightKg  Float
  moistureReadingPercent Float?
  packageCount          Int?
  qualityCondition      String?
  originPhotoUrls       String[]
  commodityData         Json?
  sellerSignoffUserId   String?
  sellerSignedAt        DateTime?
  serverTimestamp       DateTime  @default(now())
  lockedAt              DateTime?
}

// Buyer dockside receiving record (server-timestamped).
model OrderReceipt {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  buyerId           String
  baselineWeightKg  Float
  acceptedWeightKg  Float
  disputedWeightKg  Float
  reason            String?
  dockPhotoUrls     String[]
  confirmedAt       DateTime @default(now())
}

model OrderSettlementDispute {
  id                  String                    @id @default(cuid())
  orderId             String                    @unique
  order               Order                     @relation(fields: [orderId], references: [id])
  disputedWeightKg    Float
  heldSellerNetPHP    Float
  heldCommissionPHP   Float
  reason              String?
  status              SettlementDisputeStatus   @default(OPEN)
  // FARM_ORIGIN | IN_TRANSIT | UNDETERMINED — drives which claims workflow
  // applies (no insurance is claimed unless a policy/provider is configured).
  damageOrigin        String?
  proposedType        SettlementResolutionType?
  proposedSellerPct   Float?
  proposedNotes       String?
  proposedById        String?
  approvedById        String?
  resolvedAt          DateTime?
  createdAt           DateTime                  @default(now())
}

// Append-only audit trail (DB trigger blocks UPDATE/DELETE — see
// prisma/apply-revision-constraints.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CooperativeMember {
  id                 String   @id @default(cuid())
  cooperativeId      String
  cooperative        Cooperative @relation(fields: [cooperativeId], references: [id])
  name               String
  phone              String?
  outstandingDebtPHP Decimal  @default(0) @db.Decimal(14, 2)
  // Fraction (0-1) of each proceeds tranche auto-deducted toward the debt.
  deductionPct       Decimal  @default(0) @db.Decimal(5, 4)
  createdAt          DateTime @default(now())

  ledger        LoanLedgerEntry[]
  contributions LotContribution[]
  settlements   MemberSettlement[]
}

// Immutable member-loan history (DB trigger blocks UPDATE/DELETE).
model LoanLedgerEntry {
  id             String        @id @default(cuid())
  memberId       String
  member         CooperativeMember @relation(fields: [memberId], references: [id])
  type           LoanEntryType
  amountPHP      Decimal       @db.Decimal(14, 2)
  balanceAfterPHP Decimal      @db.Decimal(14, 2)
  orderId        String?
  note           String?
  createdAt      DateTime      @default(now())
}

model ConsolidatedLot {
  id             String       @id @default(cuid())
  cooperativeId  String
  cooperative    Cooperative  @relation(fields: [cooperativeId], references: [id])
  cropType       String
  cropCategory   CropCategory
  totalWeightKg  Float
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id])
  createdAt      DateTime     @default(now())

  contributions  LotContribution[]
}

model LotContribution {
  id        String   @id @default(cuid())
  lotId     String
  lot       ConsolidatedLot @relation(fields: [lotId], references: [id])
  memberId  String
  member    CooperativeMember @relation(fields: [memberId], references: [id])
  weightKg  Float
}

// Per-order allocation of cooperative proceeds to lot contributors, with the
// loan deduction taken. @@unique makes each tranche idempotent.
model MemberSettlement {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  memberId      String
  member        CooperativeMember @relation(fields: [memberId], references: [id])
  tranche       String
  proceedsPHP   Decimal  @db.Decimal(14, 2)
  deductionPHP  Decimal  @db.Decimal(14, 2)
  memberNetPHP  Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@unique([orderId, memberId, tranche])
}

model StagingHubTicket {
  id                 String            @id @default(cuid())
  cooperativeId      String
  cooperative        Cooperative       @relation(fields: [cooperativeId], references: [id])
  kind               StagingTicketKind
  memberId           String?
  weighbridgeTicketNo String
  cropType           String
  weightKg           Float
  batchCode          String?
  orderId            String?
  routeId            String?
  manifest           Json?
  notes              String?
  createdAt          DateTime          @default(now())
}

// Government benchmark prices are ONLY shown when a record with a real
// source + date exists — none are fabricated.
model BenchmarkPrice {
  id          String    @id @default(cuid())
  cropType    String
  region      String    @default("Central Luzon")
  pricePerKg  Float
  source      String
  asOfDate    DateTime
  createdById String?
  createdAt   DateTime  @default(now())
}

// Return-load cargo records for the Hauler Backhaul Finder (none are
// fabricated — the finder shows an empty state when none exist).
model BackhaulCargo {
  id                    String   @id @default(cuid())
  pickupMunicipality    String
  destinationMunicipality String
  weightKg              Float
  cargoType             String
  availableFrom         DateTime
  active                Boolean  @default(true)
  notes                 String?
  // Shipper-quoted rate for this return load; null = "not quoted" (the
  // finder never estimates or invents backhaul earnings).
  offeredPricePHP       Float?
  createdAt             DateTime @default(now())
}

// A hauler's declared inbound/return availability (dispatch Level 4).
model HaulerAvailability {
  id                      String   @id @default(cuid())
  haulerId                String
  originMunicipality      String
  destinationMunicipality String
  capacityKg              Float
  availableFrom           DateTime
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
}

// Invoice / BIR Form 2307 documents produced through a provider abstraction
// (src/lib/invoicing.ts). provider=SIMULATED documents are NOT BIR-accredited
// and carry birCompliant=false.
model InvoiceDocument {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  kind         String
  provider     String
  birCompliant Boolean  @default(false)
  payload      Json
  createdAt    DateTime @default(now())

  @@unique([orderId, kind])
}
