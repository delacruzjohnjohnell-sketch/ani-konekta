# Postgres connection string (Vercel Postgres, Supabase, or Neon all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (produce photos, QR codes) — get this from the Vercel Blob store dashboard
BLOB_READ_WRITE_TOKEN=""

# Optional/Phase 2 — not required to run the MVP, notifications.ts logs to console when absent
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
